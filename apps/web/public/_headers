# Static-asset response headers for the Workers assets layer.
#
# Hash-named build output never changes under the same URL, so tell the browser
# to keep it instead of revalidating ~40 files on every visit. Revalidation is
# cheap per request but each round costs a full RTT, which on a phone in China
# is the difference between "instant" and "why is this slow again".
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker decides what to refresh; a cached copy of it would pin an
# old app shell, so it must always be revalidated.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# HTML is the deploy's entry point: revalidate so a new build is picked up.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/offline.html
  Cache-Control: public, max-age=0, must-revalidate
